<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputName>PrintheadMaintainerInstaller</OutputName>
    <!-- The service and the program are 64-bit, so the package is too, whatever the platform of the build. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- The service and the UI are installed from where they are built, so build them first. -->
    <ServiceDir>$(MSBuildThisFileDirectory)..\PrintheadMaintainerService\x64\$(Configuration)</ServiceDir>
    <UiDir>$(MSBuildThisFileDirectory)..\PrintheadMaintainerUI\bin\$(Configuration)</UiDir>
    <!-- The version comes from Directory.Build.props. -->
    <DefineConstants>ProductVersion=$(Version);ServiceDir=$(ServiceDir);UiDir=$(UiDir)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
