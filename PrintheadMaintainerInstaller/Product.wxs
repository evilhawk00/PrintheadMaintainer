<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- The service runs as the virtual account NT SERVICE\PrintheadMaintenanceSvc. Security descriptors
       refer to that account by its service SID, S-1-5-80- followed by the SHA-1 hash of the upper-case
       service name; "sc.exe showsid PrintheadMaintenanceSvc" prints it. -->
  <?define ServiceName = "PrintheadMaintenanceSvc" ?>
  <?define ServiceSid = "S-1-5-80-1950811837-3907334835-112924277-2764943671-951326084" ?>

  <!-- Where the service keeps its settings (Settings/SettingsStore.cpp in the service). -->
  <?define SettingsKey = "SOFTWARE\evilhawk00\Printhead Maintainer" ?>

  <!-- MSI 5.0 (Windows 7 and later) is needed for PermissionEx with security descriptors. -->
  <Package Name="Printhead Maintainer" Manufacturer="evilhawk00" Version="$(var.ProductVersion)" Language="1033"
           UpgradeCode="{836CF211-F067-43F8-A021-6BB3E007F9AF}" InstallerVersion="500" Scope="perMachine">
    <MediaTemplate EmbedCab="yes"/>

    <!-- Removes an earlier version, including the 32-bit ones, before this one is installed. The
         removal is part of this installation, so it is rolled back if the installation fails. -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of [ProductName] is already installed."/>

    <Feature Id="Complete" Title="Printhead Maintainer" Description="The complete package." Display="expand" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <Feature Id="MainProgram" Title="Program" Description="The main executable." Level="1">
        <ComponentGroupRef Id="MainProgramCompGroup"/>
      </Feature>
    </Feature>

    <WixVariable Id="WixUIBannerBmp" Value="Assets\WixUIBannerBmp.bmp"/>
    <WixVariable Id="WixUIDialogBmp" Value="Assets\WixUIDialogBmp.bmp"/>
    <WixVariable Id="WixUILicenseRtf" Value="Assets\LICENSE.rtf"/>

    <Property Id="ARPHELPLINK" Value="https://github.com/evilhawk00/PrintheadMaintainer/issues"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/evilhawk00/PrintheadMaintainer"/>
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/evilhawk00/PrintheadMaintainer"/>

    <Icon Id="Icon_Blue.ico" SourceFile="Assets\Icon_Blue.ico"/>
    <Property Id="ARPPRODUCTICON" Value="Icon_Blue.ico"/>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER"/>
    <!-- The tray program starts when the setup finishes, also after a repair, which closes it. -->
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="NOT Installed OR REINSTALL"/>
    </UI>

    <Property Id="WixShellExecTarget" Value="[#PrintheadMaintainer.exe]"/>
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes"/>

    <!-- The service only keeps the privilege to traverse folders. Every other privilege of its
         account is removed, in particular SeImpersonatePrivilege, so that a flaw in the service
         gives an attacker as little as possible. -->
    <SetProperty Id="RestrictServicePrivileges" Before="RestrictServicePrivileges" Sequence="execute"
                 Value="&quot;[System64Folder]sc.exe&quot; privs $(var.ServiceName) SeChangeNotifyPrivilege"
                 Condition="NOT REMOVE~=&quot;ALL&quot;"/>
    <CustomAction Id="RestrictServicePrivileges" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check"/>

    <!-- The settings and the data folder (the log and the custom image) are kept when the program is
         upgraded and removed when it is uninstalled. The installed folder is looked up through the
         service component, which only Windows Installer can change. Its key path is a file, hence
         Type="file"; with no file signature to look for, the search gives the folder of that file. -->
    <Property Id="INSTALLEDFOLDER">
      <ComponentSearch Id="InstalledServiceFolder" Guid="{31D4345A-5EF0-47C9-BB23-25C893E97527}" Type="file"/>
    </Property>
    <SetProperty Id="DATAFOLDERTOREMOVE" Before="Wix4RemoveFoldersEx_$(sys.BUILDARCHSHORT)" Sequence="execute"
                 Value="[INSTALLEDFOLDER]Data\"
                 Condition="INSTALLEDFOLDER AND REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    <SetProperty Id="DeleteSettings" Before="DeleteSettings" Sequence="execute"
                 Value="&quot;[System64Folder]reg.exe&quot; delete &quot;HKLM\$(var.SettingsKey)&quot; /f /reg:64"
                 Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    <CustomAction Id="DeleteSettings" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore"/>

    <!-- The tray program is closed before its files are removed or replaced, when the program is
         upgraded, repaired or uninstalled. It is sent the messages of a session that ends, on which it
         exits normally and removes its icon. This is done before InstallValidate, where Windows would
         otherwise ask the user to close it, and reaches the session of the user who runs the setup.
         RebootPrompt is turned off, as a prompt, like TerminateProcess and the elevated messages,
         needs a deferred action, which cannot be scheduled before InstallInitialize. -->
    <util:CloseApplication Id="CloseTrayProgram" Target="PrintheadMaintainer.exe" EndSessionMessage="yes" RebootPrompt="no"
                           Property="TRAYPROGRAMRUNNING" Condition="NOT Installed OR REINSTALL OR REMOVE~=&quot;ALL&quot;"/>
    <!-- An instance that is still running, for example in the session of another user, where Windows
         cannot close it either, is ended before the files change, so that no restart is needed. This
         is done after RemoveExistingProducts, as no action may add to the installation script before
         it. An earlier version that an upgrade removes ends such an instance itself, before removing
         its files, from version 1.1.0.0 on. -->
    <SetProperty Id="EndTrayProgram" After="RemoveExistingProducts" Sequence="execute"
                 Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM PrintheadMaintainer.exe"
                 Condition="TRAYPROGRAMRUNNING"/>
    <CustomAction Id="EndTrayProgram" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore"/>

    <InstallExecuteSequence>
      <Custom Action="override Wix4CloseApplications_$(sys.BUILDARCHSHORT)" Before="InstallValidate"/>
      <Custom Action="EndTrayProgram" After="SetEndTrayProgram" Condition="TRAYPROGRAMRUNNING"/>
      <Custom Action="RestrictServicePrivileges" After="InstallServices" Condition="NOT REMOVE~=&quot;ALL&quot;"/>
      <Custom Action="DeleteSettings" After="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Printhead Maintainer">
        <Directory Id="InstallFolderResources" Name="Resources"/>
        <Directory Id="DataFolder" Name="Data"/>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuSubfolder" Name="Printhead Maintainer"/>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MainProgramCompGroup">
      <!-- The folder can be chosen during setup, so it does not necessarily inherit the protection of
           Program Files. Only SYSTEM and administrators may change the program; everybody may run it. -->
      <Component Id="InstallFolder" Guid="{2235AE56-8B62-4125-9847-0C0A665DEC93}" Directory="INSTALLFOLDER" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)"/>
        </CreateFolder>
      </Component>
      <Component Id="PrintheadMaintainSvc.exe" Guid="{31D4345A-5EF0-47C9-BB23-25C893E97527}" Directory="INSTALLFOLDER">
        <File Id="PrintheadMaintainSvc.exe" Source="$(var.ServiceDir)\PrintheadMaintainSvc.exe" KeyPath="yes" Checksum="yes"/>
        <!-- A virtual account has no rights beyond the ones granted to it here. -->
        <ServiceInstall Id="ServiceInstaller" Type="ownProcess" Vital="yes"
                        Name="$(var.ServiceName)" DisplayName="Printhead Maintainer Service"
                        Description="A background service designed for printers with continuous ink systems. Aims to prevent the ink from drying out by printing automatically."
                        Start="auto" Account="NT SERVICE\$(var.ServiceName)" ErrorControl="normal" Interactive="no">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60" ResetPeriodInDays="1"/>
        </ServiceInstall>
        <ServiceControl Id="StartService" Stop="both" Start="install" Remove="uninstall" Name="$(var.ServiceName)" Wait="yes"/>
      </Component>
      <Component Id="PrintheadMaintainer.exe" Guid="{874DF914-646B-4829-9584-155E3C87BAE6}" Directory="INSTALLFOLDER">
        <File Id="PrintheadMaintainer.exe" Source="$(var.UiDir)\PrintheadMaintainer.exe" KeyPath="yes"/>
        <!-- Starts the tray program at logon. The path is quoted because it can contain spaces. -->
        <RegistryValue Id="TrayAutoStartRegistry" Root="HKLM" Action="write"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Printhead Maintainer"
                       Value="&quot;[#PrintheadMaintainer.exe]&quot; /silent"
                       Type="string"/>
      </Component>
      <Component Id="System.ValueTuple.dll" Guid="{3B74AF8D-4E54-44C3-B64C-B5F2487341E0}" Directory="INSTALLFOLDER">
        <File Id="System.ValueTuple.dll" Source="$(var.UiDir)\System.ValueTuple.dll" KeyPath="yes"/>
      </Component>
      <Component Id="Microsoft.Toolkit.Uwp.Notifications.dll" Guid="{6FE56D7A-07F9-40A3-909A-05154DEE4074}" Directory="INSTALLFOLDER">
        <File Id="Microsoft.Toolkit.Uwp.Notifications.dll" Source="$(var.UiDir)\Microsoft.Toolkit.Uwp.Notifications.dll" KeyPath="yes"/>
      </Component>
      <Component Id="LICENSE.txt" Guid="{699A8650-2AEA-4AB4-A0C4-6C08A9A0FF6D}" Directory="INSTALLFOLDER">
        <File Id="LICENSE.txt" Source="InstallationFilesSourceDir\LICENSE.txt" KeyPath="yes"/>
      </Component>
      <Component Id="GithubRepository.url" Guid="{E8A32E03-93BA-4968-B5B3-A02F71BDE2FE}" Directory="INSTALLFOLDER">
        <File Id="GithubRepository.url" Source="InstallationFilesSourceDir\Github Repository.url" KeyPath="yes"/>
      </Component>
      <Component Id="DefaultPrint.bmp" Guid="{3B6ACC5E-428D-4C6A-B5DA-56F21BC07F94}" Directory="InstallFolderResources">
        <File Id="DefaultPrint.bmp" Source="InstallationFilesSourceDir\Resources\DefaultPrint.bmp" KeyPath="yes"/>
      </Component>
      <!-- Where the service keeps its data. Only the service may change it; users may read the data
           folder (the UI shows the log and the image) but not the settings, which they change through
           the service. -->
      <Component Id="ServiceData" Guid="{73773C02-8B38-4726-9435-8F777F40ED5A}" Directory="DataFolder" KeyPath="yes">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;$(var.ServiceSid))(A;OICI;0x1200a9;;;BU)"/>
        </CreateFolder>
        <util:RemoveFolderEx On="uninstall" Property="DATAFOLDERTOREMOVE"/>
        <RegistryKey Root="HKLM" Key="$(var.SettingsKey)" ForceCreateOnInstall="yes">
          <PermissionEx Sddl="D:PAI(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;0x2001b;;;$(var.ServiceSid))"/>
        </RegistryKey>
      </Component>
      <Component Id="ProgramMenuDir" Guid="{64279115-F18E-4EFE-BCD8-FB312924B3C6}" Directory="ProgramMenuSubfolder">
        <Shortcut Id="PrintheadMaintainerShortcut" Name="Printhead Maintainer" Description="Printhead Maintainer is designed for printers with continuous ink systems. Aims to prevent the ink from drying out by printing automatically."
                  Target="[INSTALLFOLDER]PrintheadMaintainer.exe" WorkingDirectory="INSTALLFOLDER"/>
        <RemoveFolder Id="ProgramMenuSubfolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\[Manufacturer]\[ProductName]" Type="string" Value="" KeyPath="yes"/>
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
